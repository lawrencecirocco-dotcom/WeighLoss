# Optional integrations. Never commit .env or paste keys into the app.
# Manual tracking works without any credentials.
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:3001/api/fitbit/callback
# Development origin. For npm start, use http://localhost:3001 instead.
APP_ORIGIN=http://localhost:5173
# Set a server-side AI key to enable photo estimates and personalised snack suggestions.
LIGHTER_AI_KEY=
OPENAI_MODEL=gpt-4.1-mini
# API listens only on the local interface.
PORT=3001

# Required for production / optional to test private access locally.
# Choose a unique password of at least 12 characters; never put it in chat.
APP_PASSWORD=
# At least 32 random characters. Keep this stable to decrypt saved connections.
# Render generates this automatically from render.yaml.
DATA_ENCRYPTION_KEY=
# Hosting template sets these; keep the local default otherwise.
# HOST=0.0.0.0
# TRUST_PROXY=1
# DATA_DIR=/var/data/lighter
